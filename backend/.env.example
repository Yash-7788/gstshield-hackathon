# GSTShield backend configuration template
# Copy to backend/.env for local development. Never commit .env or real secrets.
# Status: the selected settings are loaded and validated by app/config.py.
# Feature limits apply in their implementation phases; validation alone is not enforcement.
# PC-only, one process, synthetic demo documents. No cloud/server/database account.
# Settings must be validated by app/config.py before the relevant feature starts.

# ---------------------------------------------------------------------------
# Application and network
# ---------------------------------------------------------------------------
# Allowed APP_ENV values: local, demo, test. All modes currently run on this PC.
APP_ENV=local
# Sample-data labeling only. This flag must NEVER bypass authorization/signatures.
DEMO_MODE=true
LOG_LEVEL=INFO
# Loopback only (127.0.0.1 or ::1). python -m app reads HOST and PORT.
HOST=127.0.0.1
PORT=8000
# Use the SAME HTTP hostname for website/API browser sessions.
# Different ports work; do not mix localhost with 127.0.0.1.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
# JSON array of exact origins (scheme + host + port), with no trailing path.
# Include only the origins you actually use. No wildcard origins for private data.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------------------------------------------------------------------------
# Local storage and process limits
# ---------------------------------------------------------------------------
# Phase 2 uses Python's built-in SQLite driver; no external DB service.
# The private database is created at startup or by offline administration.
STORAGE_BACKEND=sqlite
# Private files/database stay inside backend/data (relative to backend, not cwd).
LOCAL_DATA_DIR=data
# Exactly one worker for predictable local jobs and resource limits.
WEB_CONCURRENCY=1
# Enforced absolute local-session expiry, positive seconds, at most one day.
SESSION_TTL_SECONDS=1800
# Planned in-process retained-state/buffer budget in bytes (64 MiB).
# This does not bound parser buffers/process RSS; parsing limits apply separately.
MEMORY_STATE_MAX_BYTES=67108864
MAX_ACTIVE_DEMO_SESSIONS=20
# Reject excess work explicitly; never silently drop requests.
MAX_CONCURRENT_PROCESSING_JOBS=1
MAX_QUEUED_JOBS_PER_WORKSPACE=5
MAX_IMPORTS_PER_WORKSPACE=20
# Imports and runs share one child process and one workspace queue budget.
# Private child result, sampled child RSS and upload wall-clock bounds.
MAX_PARSED_IMPORT_BYTES=16777216
MAX_PARSER_RSS_BYTES=268435456
MAX_UPLOAD_RECEIVE_SECONDS=20

# ---------------------------------------------------------------------------
# Structured upload and parser bounds
# ---------------------------------------------------------------------------
# Allowed structured imports: CSV, XLSX and supported JSON. Not arbitrary archives.
# All *_BYTES values are exact bytes; all *_SECONDS values are seconds.
MAX_UPLOAD_BYTES=5242880
MAX_IMPORT_ROWS=2000
MAX_IMPORT_COLUMNS=50
MAX_CELL_CHARACTERS=10000
MAX_JSON_DEPTH=20
MAX_XLSX_UNCOMPRESSED_BYTES=52428800
MAX_XLSX_ARCHIVE_ENTRIES=1000
# Enforced against the disposable import/run process tree, killed on expiry.
PROCESSING_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Reconciliation policy (not legal eligibility or automatic payment approval)
# ---------------------------------------------------------------------------
# Exact decimal strings, parsed using Decimal; no binary floating-point money.
CURRENCY=INR
MATCH_AMOUNT_TOLERANCE=0.01
# Score range 0..100. Suggestions still require review, even above these values.
FUZZY_SUGGESTION_THRESHOLD=88.00
FUZZY_MIN_SCORE_GAP=5.00
MATCH_POLICY_VERSION=match-v1
# Retained runs per workspace; compared pairs and stored candidates per run.
# Limits fail the run explicitly; ambiguity is never hidden by truncation.
MAX_RUNS_PER_WORKSPACE=20
MAX_MATCH_PAIRS=4000000
MAX_MATCH_CANDIDATES=10000

# ---------------------------------------------------------------------------
# Private access and authentication
# ---------------------------------------------------------------------------
# Local accounts are provisioned offline with python -m app.manage user-create.
# Browser sessions use HttpOnly cookies and Origin/CSRF protected mutations.
# DEMO_MODE is NOT an auth mode; no backend secret belongs in frontend variables.
# No Supabase, hosted identity service or cloud database is selected.
# No placeholder password, fallback JWT secret or auth-disable switch is provided.

# ---------------------------------------------------------------------------
# WhatsApp (optional; disabled until configured and physical-phone tested)
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
# Exact HTTPS origin approved for forwarding ONLY /webhooks/whatsapp and /wa/reports/*.
# It does not expose browser/auth/business routes; do not add it to CORS_ORIGINS.
# Configure the callback method yourself; GSTShield never provisions a tunnel/server.
WHATSAPP_PUBLIC_URL=
# When enabled, ALL six META_* values below must be nonempty and valid.
# Choose a currently supported Graph version for the actual account, e.g. vXX.X.
# Do not copy the illustrative vXX.X into real configuration.
META_GRAPH_VERSION=
# IDs from the provisioned sender phone number and WhatsApp Business Account.
META_PHONE_NUMBER_ID=
META_WABA_ID=
# SECRET: scoped token; check expiry and permissions before rehearsal.
META_ACCESS_TOKEN=
# SECRET: signs incoming callback bytes; different from access/verification tokens.
META_APP_SECRET=
# SECRET: random value used only for the GET webhook verification challenge.
META_VERIFY_TOKEN=
# Callback path: /webhooks/whatsapp. Real phone callbacks require internet
# and an HTTPS URL reachable by Meta; loopback cannot receive them.
# POST signature validation is mandatory; no unsigned-demo fallback is allowed.
# Zero prevents outbound sends until actual account entitlement has been checked.
# Enforced cumulative attempt cap in private storage, including failed/uncertain sends.
# Raising it permits additional attempts. It is not a provider billing/price guarantee.
WHATSAPP_SEND_BUDGET=0
# Positive seconds. Avoid automatic resend after ambiguous send timeouts.
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=20
HTTP_WRITE_TIMEOUT_SECONDS=20
HTTP_POOL_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Linking, report capabilities and abuse limits
# ---------------------------------------------------------------------------
# Linking codes are generated per request; they are NOT environment secrets.
LINK_CODE_TTL_SECONDS=600
LINK_ATTEMPTS_PER_WINDOW=5
LINK_ATTEMPT_WINDOW_SECONDS=600
DOWNLOAD_CAPABILITY_TTL_SECONDS=600
DOWNLOAD_CAPABILITY_MAX_DOWNLOADS=3
READ_REQUESTS_PER_MINUTE=60
MUTATION_REQUESTS_PER_MINUTE=10
IMPORT_REQUESTS_PER_MINUTE=3
# Session, import and channel limits persist in SQLite. Link/capability TTLs are capped at 600 sec.
# Never log tokens, full source files, linking codes or download capabilities.

# Not selected: external DATABASE_URL, ORM, Redis, cloud storage or AI services.
# Keep WHATSAPP_ENABLED=false until Meta assets, permitted recipients and callback are configured.
# Physical-phone acceptance remains mandatory; local provider fixtures are not proof.

# Phase 2: enforced local storage and small JSON request limits.
# Database, rollback journal and backups share the retained-data budget.
MAX_DATABASE_BYTES=67108864
MAX_LOCAL_DATA_BYTES=268435456
MIN_FREE_DISK_BYTES=16777216
MAX_LOCAL_BACKUPS=3
MAX_LOCAL_USERS=20
MAX_LOCAL_WORKSPACES=20
MAX_REGISTRATIONS_PER_WORKSPACE=20
MAX_API_BODY_BYTES=65536
# Phase 7: total wall-clock budget for ordinary mutation request bodies (1-60 sec).
# Uploads use MAX_UPLOAD_RECEIVE_SECONDS and their separately authenticated receiver.
MAX_API_RECEIVE_SECONDS=20

# Phase 5: bounded local evidence, proposals and private generated artifacts.
# Reports are private SQLite blobs included in backups. No cloud renderer or bucket.
MAX_CASES_PER_WORKSPACE=100
MAX_CASE_EVENTS=100
MAX_PROPOSALS_PER_WORKSPACE=20
MAX_ARTIFACTS_PER_WORKSPACE=40
MAX_ARTIFACT_BYTES=5242880
MAX_REPORT_SNAPSHOT_BYTES=8388608
ARTIFACT_TTL_SECONDS=604800
MAX_REPORT_ROWS=200
MAX_REPORT_PAGES=100

# Phase 6: local automatic business actions; no government/provider calls.
# Histories include closed actions. Limits never silently discard an unresolved issue.
MAX_ACTIONS_PER_WORKSPACE=3000
MAX_ACTION_EVENTS=100
# One workspace per tick, rotating fairly; authenticated queue reads also catch up.
# Checks stop when the PC/backend is off. Startup resumes overdue review tracking.
AUTOMATION_INTERVAL_SECONDS=5
AUTOMATION_SOURCE_BATCH=8
AUTOMATION_DUE_BATCH=50

# Invoice extraction: backend-only credentials; never use VITE_* for secrets.
# Each document upload requires explicit consent to send it to Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=20
MAX_PASSPORTS_PER_WORKSPACE=100
