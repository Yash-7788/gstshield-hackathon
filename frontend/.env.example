# Public browser configuration only. No account passwords or backend/Meta secrets.
# This is the only exposed setting; other VITE_ names are not automatically published.
# Optional: omit to use the current website hostname with API port 8000.
# Website and API must use the SAME loopback HTTP hostname (different ports are fine).
# Match backend PUBLIC_API_URL; keep website origin in backend CORS_ORIGINS.
VITE_API_BASE_URL=http://localhost:8000
